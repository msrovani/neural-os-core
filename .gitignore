target/
# Builds isolados: usar target/agent-*, target/check-*, target/s106 (sob target/).
# Rede de segurança para leftovers legados na raiz (não criar novos):
target-*/
target_*.txt
*-check*.log
*-check*.txt

# Compiled binaries / disk images
*.bin
*.o
*.elf

# QEMU artifacts
*.qcow2
*.vmdk
*.vdi

# Rust project files (Cargo.lock is committed for executables)

# IDE/editor artifacts
.vscode/
.idea/
*.swp
*.swo
*~

# OS metadata
Thumbs.db
.DS_Store

# QEMU debug logs (use target/qemu-logs/)
qemu*.log

# MemPalace per-project files (issue #185)
mempalace.yaml
entities.json

logs/

*.img
neural-os-hwtest.*

# keep firmware/ tracked (MIT blobs needed for WPR boot)
!firmware/**
# GSP NVIDIA: dezenas de MB, ABI pin (535/570) instável — só em target/firmware/
# (python tools/download_firmware.py copia GSP só para target/)
firmware/nvidia/**/gsp/
firmware/**/gsp-*.bin

# Chave privada de assinatura do kernel
keys/kernel_secret.key
# Chave pública (deve ser rastreada para verificação de assinatura)
!keys/kernel_public.bin

tools/model_cache/
tools/debug_build.py
tools/__pycache__/
tools/*.jsonl
tools/*.pcap

tools/disk_*
MICRO.BITNET
tools/MICRO.BITNET
pipenv
