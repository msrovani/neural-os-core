target/
# Builds isolados: usar target/agent-*, target/check-*, target/s106 (sob target/).
# Rede de segurança para leftovers legados na raiz (não criar novos):
target-*/
target1/
target_*.txt
*-check*.log
*-check*.txt

# Compiled binaries / disk images
*.bin
*.o
*.elf
# Goldens .bitnet v6 usados por include_bytes! nos testes Rust (cortex) — NÃO ignorar
!tools/golden_v6.bin
!tools/golden_q6k.bin
!tools/golden_q6k_ref.f32

# QEMU artifacts
*.qcow2
*.vmdk
*.vdi

# Rust project files (Cargo.lock is committed for executables)

# IDE/editor artifacts
.vscode/
.idea/
*.swp
*.swo
*~

# OS metadata
Thumbs.db
.DS_Store

# QEMU debug logs (use target/qemu-logs/)
qemu*.log

# MemPalace per-project files (issue #185)
mempalace.yaml
entities.json

logs/

*.img
neural-os-hwtest.*

# firmware: baixado via python tools/download_firmware.py (hash verificada) — NÃO versionar
# FW_POLICY.txt permanece rastreado (política/licença por família)
firmware/**
!firmware/FW_POLICY.txt
# GSP NVIDIA: dezenas de MB, ABI pin (535/570) instável — só em target/firmware/
# (python tools/download_firmware.py copia GSP só para target/)
firmware/nvidia/**/gsp/
firmware/**/gsp-*.bin

# Chave privada de assinatura do kernel
keys/kernel_secret.key
# Chave pública (deve ser rastreada para verificação de assinatura)
!keys/kernel_public.bin

tools/model_cache/
tools/debug_build.py
tools/__pycache__/
tools/*.jsonl
tools/*.pcap

tools/disk_*
MICRO.BITNET
tools/MICRO.BITNET
pipenv

# Cursor plan drafts — não misturar com releases (hazard SESSION_176)
.cursor/plans/

# Modelos grandes (>100 MB) - apenas local
*.safetensors
models/llm_moe/bitnet_2B.bitnet
models/tokenizer/BGE_M3.BIN
# Modelos de terceiros (MIT) — baixados via tools/download_models.py
models/tokenizer/PIPER_PT_BR.BIN
models/tokenizer/E5_MULTI.BIN
